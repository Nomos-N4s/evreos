# The English interface catalogue. FR-035 keys interface text by the primary
# language subtag alone, so this file is named `en` and nothing longer: a
# region subtag in the filename would re-fuse language and place.
#
# One message per line, `key = text`. A `{name}` is a named argument supplied
# at resolution, never text of this file, which is how FR-042 keeps brand
# names out of message text.

# FR-015's four navigation failures: each cause named, each with a next step.
error.unresolvable.cause = The address {address} could not be found.
error.unresolvable.next_step = Check the spelling of the address and try again.
error.certificate.cause = The identity of {host} could not be confirmed: its certificate is untrusted or has expired.
error.certificate.next_step = Go back to the previous page. Continue only if you trust this network.
error.intercepted.cause = Something on this network is answering in place of {host}.
error.intercepted.next_step = Sign in to the network, or switch to a connection you trust.
error.authentication.cause = {host} asks you to sign in before the page will load.
error.authentication.next_step = Sign in to continue.

# FR-016a: the one neutral entry point to the home surface, present in the
# browser's own menus from first run. A static label, no brand name, no state.
menu.home_surface = Apps
